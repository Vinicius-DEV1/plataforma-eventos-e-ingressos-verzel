# Ambiente da suíte de testes. Copie para .env.test.
#
# Banco separado do de desenvolvimento, em outra porta, para a suíte poder
# truncar as tabelas a cada teste sem apagar os dados com que você trabalha.
# Sobe com: docker compose --profile test up -d postgres-test
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/eventos_test?schema=public"

# Qualquer valor serve: os testes assinam e verificam com a mesma chave, e a
# falsificação de QR é testada assinando com outra.
JWT_SECRET=segredo-de-teste
