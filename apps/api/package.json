{
  "name": "@eventos/api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da plataforma de eventos e ingressos.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "express": "^5.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12"
  }
}
