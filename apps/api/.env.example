# Servidor
NODE_ENV=development
PORT=3333
# Fixa o fuso do processo: as regras de prazo são calculadas em UTC
# (docs/PRD.md §3.13).
TZ=UTC

# Banco de dados (PostgreSQL)
# Em desenvolvimento, o host é o serviço do Docker Compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventos?schema=public"

# Chave usada para assinar os tokens de sessão e o payload dos QR Codes.
# Gere um valor aleatório longo — nunca versione o valor real.
JWT_SECRET=

# Origem(ns) do front autorizada(s) pelo CORS, separadas por vírgula caso
# haja mais de uma (ex: produção + preview). Sem valor, cai no padrão de
# desenvolvimento (porta padrão do Vite).
CORS_ORIGIN=http://localhost:5173

# Pagamento simulado — Asaas (ambiente sandbox)
ASAAS_API_KEY=

# Catálogo de filmes — TMDb
TMDB_API_KEY=

# Catálogo de shows — Ticketmaster Discovery
TICKETMASTER_API_KEY=
