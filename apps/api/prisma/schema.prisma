generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

enum EventType {
  CINEMA
  SHOW
}

enum EventStatus {
  PUBLISHED
  CANCELLED
}

enum ExternalSource {
  TMDB
  TICKETMASTER
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum ReservationStatus {
  PENDING
  PAID
  DECLINED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  DECLINED
  REFUNDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  organizedEvents  Event[]       @relation("EventOrganizer")
  reservations     Reservation[]
  validatedTickets Ticket[]      @relation("TicketValidator")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  events Event[]
}

model Event {
  id               String         @id @default(cuid())
  title            String
  description      String
  type             EventType
  /// Opcional: uma categoria apagada (Bloco de gestão de categorias) deixa
  /// os eventos que a usavam sem categoria, em vez de bloquear a exclusão
  /// ou quebrar a leitura desses eventos.
  categoryId       String?
  venue            String
  startsAt         DateTime
  basePrice        Decimal        @db.Decimal(10, 2)
  totalCapacity    Int
  /// Only meaningful for SHOW events. In CINEMA events availability comes
  /// from counting seats, so this field is ignored (SPEC §1.2).
  availableTickets Int            @default(0)
  imageUrl         String
  externalSource   ExternalSource
  externalId       String
  organizerId      String
  status           EventStatus    @default(PUBLISHED)
  createdAt        DateTime       @default(now())

  organizer    User          @relation("EventOrganizer", fields: [organizerId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seats        Seat[]
  reservations Reservation[]

  @@index([status, startsAt])
  @@index([categoryId])
}

model Seat {
  id      String     @id @default(cuid())
  eventId String
  row     String
  number  Int
  status  SeatStatus @default(AVAILABLE)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([eventId, row, number])
  @@index([eventId, status])
}

model Reservation {
  id          String            @id @default(cuid())
  eventId     String
  customerId  String
  /// Set only for CINEMA events; mutually exclusive with `quantity`.
  seatId      String?
  /// Set only for SHOW events; mutually exclusive with `seatId`.
  quantity    Int?
  status      ReservationStatus @default(PENDING)
  totalAmount Decimal           @db.Decimal(10, 2)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())

  event    Event    @relation(fields: [eventId], references: [id])
  customer User     @relation(fields: [customerId], references: [id])
  seat     Seat?    @relation(fields: [seatId], references: [id])
  tickets  Ticket[]
  payment  Payment?

  @@index([eventId, status, expiresAt])
  @@index([customerId])
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String
  qrCode        String
  status        TicketStatus @default(VALID)
  validatedAt   DateTime?
  validatedById String?
  shareToken    String       @unique @default(cuid())
  createdAt     DateTime     @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  validatedBy User?       @relation("TicketValidator", fields: [validatedById], references: [id])

  @@index([reservationId])
}

model Payment {
  id             String        @id @default(cuid())
  reservationId  String        @unique
  asaasPaymentId String
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
}
